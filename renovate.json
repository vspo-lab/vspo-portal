{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>vspo-lab/config//renovate", ":dependencyDashboard"],
  "timezone": "Asia/Tokyo",
  "baseBranches": ["develop"],
  "schedule": ["* 0-3 * * *"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "internalChecksFilter": "strict",
  "automerge": false,
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 * * 1"],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Type definitions: erased at compile time, so a passing tsc proves no runtime change",
      "matchPackageNames": ["@types/**"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "type-definitions",
      "addLabels": ["no-runtime-impact"]
    },
    {
      "description": "GitHub Actions: CI only, never part of a deployed artifact",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "groupName": "github-actions",
      "addLabels": ["no-runtime-impact"]
    },
    {
      "description": "Lint, format and docs tooling: runs in CI only, emits no shipped code",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": [
        "@biomejs/biome",
        "cspell",
        "knip",
        "markdownlint-cli2",
        "textlint",
        "textlint-**",
        "@textlint/**",
        "lefthook"
      ],
      "groupName": "lint-tooling",
      "addLabels": ["no-runtime-impact"]
    },
    {
      "description": "Test tooling: never imported by production code",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "@testing-library/**",
        "jsdom",
        "happy-dom"
      ],
      "groupName": "test-tooling",
      "addLabels": ["no-runtime-impact"]
    },
    {
      "description": "Build-chain devDependencies: change emitted output, so impact is not provable from CI alone",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": [
        "tsup",
        "turbo",
        "typescript",
        "storybook",
        "@storybook/**",
        "@vitejs/**",
        "@tailwindcss/**",
        "wrangler",
        "@opennextjs/cloudflare",
        "@astrojs/**"
      ],
      "groupName": "build-tooling"
    },
    {
      "description": "Remaining devDependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dev-dependencies"
    },
    {
      "description": "Production patch updates: runtime behavior can change, reviewed before merge",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "groupName": "production-patch"
    },
    {
      "description": "Production minor updates: grouped into one PR, merged deliberately",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor"],
      "groupName": "production-minor"
    },
    {
      "description": "Core frameworks: reviewed individually",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "wrangler",
        "@opennextjs/cloudflare",
        "@cloudflare/workers-types",
        "typescript",
        "@biomejs/biome",
        "astro"
      ],
      "groupName": null,
      "addLabels": ["high-risk"]
    },
    {
      "description": "Major updates: handled as feature work via the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "addLabels": ["major"]
    }
  ]
}
