{
  "name": "vspo-portal",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "turbo build",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint --apply .",
    "biome:unsafe-fix": "biome check --fix --unsafe",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "tsc": "pnpm -r exec tsc --noEmit",
    "generate-openapi": "pnpm --filter @vspo-lab/api generate-openapi",
    "dev:vspo-schedule-web": "pnpm --filter vspo-schedule-v2-web dev",
    "textlint": "textlint \"{README.md,docs/**/*.md}\"",
    "textlint:fix": "textlint --fix \"{README.md,docs/**/*.md}\"",
    "markdownlint": "markdownlint-cli2",
    "markdownlint:fix": "markdownlint-cli2 --fix",
    "security-scan": "./scripts/security-scan.sh",
    "security-scan:docker": "./scripts/security-scan.sh --docker",
    "cspell": "cspell lint ."
  },
  "author": "sugar-cat7",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@types/node": "catalog:",
    "cspell": "^9.8.0",
    "knip": "^6.32.0",
    "markdownlint-cli2": "^0.23.0",
    "textlint": "^15.8.0",
    "textlint-rule-common-misspellings": "^1.0.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.16": "5.0.9",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "defu@>=6.0.0 <6.1.5": ">=6.1.5",
      "devalue@>=5.0.0 <5.8.1": "5.8.2",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.6",
      "fast-xml-builder@>=1.0.0 <1.1.7": "1.1.7",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "minimatch@>=8.0.0 <10.0.0": "10.2.5",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss@>=8.0.0 <8.5.18": "8.5.23",
      "sharp@>=0.34.0 <0.35.0": "0.35.3",
      "svgo@>=4.0.0 <4.0.2": "4.0.2",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "vite@>=7.0.0 <7.3.5": "7.3.6",
      "ws@>=8.0.0 <8.21.0": "8.21.1"
    }
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "pnpm": ">=9.15.9",
    "node": ">=22.12.0"
  }
}
